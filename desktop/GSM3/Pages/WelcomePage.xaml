<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GSM3.Pages.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GSM3.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="620">
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="40">
                <Grid RowSpacing="32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ========== Step Content Area ========== -->
                    <Grid Grid.Row="0" MinHeight="360">

                        <!-- Step 1: Welcome -->
                        <StackPanel
                            x:Name="Step1Panel"
                            Spacing="20"
                            VerticalAlignment="Center">
                            <FontIcon
                                Glyph="&#xE7FC;"
                                FontSize="64"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock
                                Text="欢迎使用 GSM3"
                                FontSize="32"
                                FontWeight="Bold"
                                HorizontalAlignment="Center" />
                            <TextBlock
                                TextWrapping="Wrap"
                                TextAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontSize="15"
                                Text="GSM3 是一个功能强大的游戏服务器管理面板，帮助您轻松部署和管理各种游戏服务器。" />

                            <Border
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                CornerRadius="8"
                                Padding="20"
                                Margin="0,8,0,0">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon Glyph="&#xE896;" FontSize="16"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="一键部署 Steam 游戏服务器和 Minecraft 服务器" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon Glyph="&#xE7F8;" FontSize="16"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="统一管理多个游戏服务器实例" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon Glyph="&#xE9D9;" FontSize="16"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="实时系统资源监控与告警" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon Glyph="&#xE756;" FontSize="16"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="内置终端、RCON 控制台与定时任务" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon Glyph="&#xE895;" FontSize="16"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="自动备份与恢复功能" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Step 2: Configure Paths -->
                        <StackPanel
                            x:Name="Step2Panel"
                            Spacing="20"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                            <FontIcon
                                Glyph="&#xE713;"
                                FontSize="48"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock
                                Text="基本配置"
                                FontSize="24"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center" />
                            <TextBlock
                                TextWrapping="Wrap"
                                TextAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="请配置以下路径。如果不确定，可以留空使用默认设置，稍后在设置中修改。" />

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="WizardSteamCMDPath"
                                    Grid.Column="0"
                                    Header="SteamCMD 安装路径"
                                    PlaceholderText="选择 SteamCMD 安装位置" />
                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Bottom"
                                    Content="浏览..."
                                    Click="BrowseSteamCMDPath_Click" />
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="WizardGameInstallPath"
                                    Grid.Column="0"
                                    Header="游戏服务器默认安装路径"
                                    PlaceholderText="选择游戏服务器安装位置" />
                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Bottom"
                                    Content="浏览..."
                                    Click="BrowseGameInstallPath_Click" />
                            </Grid>

                            <InfoBar
                                x:Name="PathValidationInfoBar"
                                IsClosable="False"
                                IsOpen="False"
                                Severity="Warning"
                                Title="路径未设置"
                                Message="请设置 SteamCMD 和游戏安装路径后再继续。" />

                            <InfoBar
                                x:Name="PathInfoBar"
                                Title="提示"
                                Message="建议使用 SSD 硬盘上的路径以获得更好的性能。确保所选路径有足够的磁盘空间。"
                                Severity="Informational"
                                IsOpen="True"
                                IsClosable="False" />
                        </StackPanel>

                        <!-- Step 3: Quick Deploy -->
                        <StackPanel
                            x:Name="Step3Panel"
                            Spacing="20"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                            <FontIcon
                                Glyph="&#xE7B5;"
                                FontSize="48"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock
                                Text="快速部署"
                                FontSize="24"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center" />
                            <TextBlock
                                TextWrapping="Wrap"
                                TextAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="是否要现在部署您的第一个游戏服务器？您也可以稍后在「游戏部署」页面中操作。" />

                            <Border
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                CornerRadius="8"
                                Padding="20">
                                <StackPanel Spacing="16">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon Glyph="&#xE7FC;" FontSize="20"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Steam 游戏服务器" FontWeight="SemiBold" />
                                            <TextBlock Text="支持幻兽帕鲁、方舟、CS2 等数十款游戏"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       FontSize="13" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon Glyph="&#xE74C;" FontSize="20"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Minecraft 服务器" FontWeight="SemiBold" />
                                            <TextBlock Text="支持 Java 版和基岩版服务器部署"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       FontSize="13" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Button
                                x:Name="DeployNowButton"
                                HorizontalAlignment="Center"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="DeployNow_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE896;" />
                                    <TextBlock Text="立即前往部署页面" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Step 4: Done -->
                        <StackPanel
                            x:Name="Step4Panel"
                            Spacing="20"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                            <FontIcon
                                Glyph="&#xE930;"
                                FontSize="64"
                                HorizontalAlignment="Center"
                                Foreground="Green" />
                            <TextBlock
                                Text="设置完成！"
                                FontSize="32"
                                FontWeight="Bold"
                                HorizontalAlignment="Center" />
                            <TextBlock
                                TextWrapping="Wrap"
                                TextAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontSize="15"
                                Text="您已完成初始设置。现在可以开始使用 GSM3 管理您的游戏服务器了。" />

                            <Border
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                CornerRadius="8"
                                Padding="20">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="接下来您可以：" FontWeight="SemiBold" />
                                    <TextBlock Text="1. 在「游戏部署」页面部署游戏服务器" />
                                    <TextBlock Text="2. 在「实例管理」页面创建自定义实例" />
                                    <TextBlock Text="3. 在「系统监控」页面查看系统状态" />
                                    <TextBlock Text="4. 在「设置」页面调整更多选项" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ========== Bottom Navigation ========== -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Step Indicators -->
                        <StackPanel
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                            <Ellipse x:Name="Dot1" Width="10" Height="10" />
                            <Ellipse x:Name="Dot2" Width="10" Height="10" />
                            <Ellipse x:Name="Dot3" Width="10" Height="10" />
                            <Ellipse x:Name="Dot4" Width="10" Height="10" />
                            <TextBlock
                                x:Name="StepIndicatorText"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontSize="13"
                                Text="步骤 1 / 4" />
                        </StackPanel>

                        <!-- Navigation Buttons -->
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                x:Name="BackButton"
                                Content="上一步"
                                Click="Back_Click"
                                Visibility="Collapsed"
                                MinWidth="80" />
                            <Button
                                x:Name="SkipButton"
                                Content="跳过向导"
                                Click="Skip_Click"
                                MinWidth="80" />
                            <Button
                                x:Name="NextButton"
                                Content="下一步"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="Next_Click"
                                MinWidth="80" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
