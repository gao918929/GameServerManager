<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GSM3.Pages.TerminalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GSM3.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title row with history flyout and clear -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="终端" />

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="4">
                <Button x:Name="HistoryButton" ToolTipService.ToolTip="历史命令">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE81C;" />
                        <TextBlock Text="历史命令" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="HistoryFlyout">
                            <StackPanel Width="300" Spacing="4">
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="最近命令" />
                                <ListView
                                    x:Name="HistoryList"
                                    MaxHeight="300"
                                    SelectionChanged="HistoryList_SelectionChanged">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                FontFamily="Cascadia Mono, Consolas, monospace"
                                                FontSize="13"
                                                Text="{Binding}" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock
                                    x:Name="HistoryEmptyText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="暂无历史命令"
                                    Visibility="Visible" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button
                    x:Name="ClearScreenButton"
                    Click="ClearScreenButton_Click"
                    ToolTipService.ToolTip="清屏">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                        <TextBlock Text="清屏" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Quick command buttons -->
        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="4">
            <TextBlock
                Margin="0,0,4,0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="快捷命令:" />
            <Button
                Click="QuickCommand_Click"
                Content="dir"
                FontFamily="Cascadia Mono, Consolas, monospace"
                FontSize="12"
                Padding="8,4"
                Tag="dir" />
            <Button
                Click="QuickCommand_Click"
                Content="cd"
                FontFamily="Cascadia Mono, Consolas, monospace"
                FontSize="12"
                Padding="8,4"
                Tag="cd" />
            <Button
                Click="QuickCommand_Click"
                Content="netstat"
                FontFamily="Cascadia Mono, Consolas, monospace"
                FontSize="12"
                Padding="8,4"
                Tag="netstat -ano" />
            <Button
                Click="QuickCommand_Click"
                Content="tasklist"
                FontFamily="Cascadia Mono, Consolas, monospace"
                FontSize="12"
                Padding="8,4"
                Tag="tasklist" />
            <Button
                Click="QuickCommand_Click"
                Content="ipconfig"
                FontFamily="Cascadia Mono, Consolas, monospace"
                FontSize="12"
                Padding="8,4"
                Tag="ipconfig" />
            <Button
                Click="QuickCommand_Click"
                Content="systeminfo"
                FontFamily="Cascadia Mono, Consolas, monospace"
                FontSize="12"
                Padding="8,4"
                Tag="systeminfo" />
        </StackPanel>

        <!-- TabView with terminal sessions -->
        <TabView
            x:Name="TerminalTabView"
            Grid.Row="2"
            AddTabButtonClick="TabView_AddTabButtonClick"
            IsAddTabButtonVisible="True"
            SelectionChanged="TabView_SelectionChanged"
            TabCloseRequested="TabView_TabCloseRequested"
            TabWidthMode="SizeToContent">
            <TabView.TabStripFooter>
                <StackPanel
                    Margin="8,0,0,0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <ComboBox
                        x:Name="InstanceSelector"
                        Width="200"
                        PlaceholderText="选择实例"
                        SelectedIndex="0">
                        <ComboBoxItem Content="通用终端" />
                    </ComboBox>
                </StackPanel>
            </TabView.TabStripFooter>
        </TabView>

        <!-- Command input area -->
        <Grid
            Grid.Row="3"
            Margin="0,4,0,0"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="CommandInput"
                Grid.Column="0"
                FontFamily="Cascadia Mono, Consolas, monospace"
                KeyDown="CommandInput_KeyDown"
                PlaceholderText="输入命令..." />

            <Button
                x:Name="SendButton"
                Grid.Column="1"
                Click="SendButton_Click"
                Style="{StaticResource AccentButtonStyle}"
                ToolTipService.ToolTip="发送">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="14" Glyph="&#xE724;" />
                    <TextBlock Text="发送" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
