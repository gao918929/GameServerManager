<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GSM3.Pages.ServerStatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GSM3.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid Padding="24,16,24,16" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock
                Grid.Row="0"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="服务器状态查询" />

            <!-- Instance Status Section -->
            <Border
                Grid.Row="1"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="实例状态" />
                        <Button
                            x:Name="RefreshInstancesButton"
                            Grid.Column="1"
                            Click="RefreshInstancesButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                <TextBlock Text="刷新全部实例" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ListView
                        x:Name="InstanceListView"
                        Padding="4"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    Padding="12,8"
                                    ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Status indicator -->
                                    <Ellipse
                                        Grid.Column="0"
                                        Width="10"
                                        Height="10"
                                        VerticalAlignment="Center"
                                        Fill="{Binding StatusColor}" />

                                    <!-- Instance Name -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{Binding DisplayName}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding StatusSummary}" />
                                    </StackPanel>

                                    <!-- Port -->
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding PortText}" />

                                    <!-- Ping -->
                                    <TextBlock
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding PingText}" />

                                    <!-- Type badge -->
                                    <Border
                                        Grid.Column="4"
                                        Padding="6,2"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                        CornerRadius="4">
                                        <TextBlock
                                            FontSize="11"
                                            Text="{Binding TypeText}" />
                                    </Border>

                                    <!-- Refresh button -->
                                    <Button
                                        Grid.Column="5"
                                        Padding="6,4"
                                        VerticalAlignment="Center"
                                        Click="QueryInstanceItem_Click"
                                        Tag="{Binding InstanceId}"
                                        ToolTipService.ToolTip="查询">
                                        <FontIcon FontSize="12" Glyph="&#xE72C;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        x:Name="NoInstancesText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="没有已配置端口的实例"
                        Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Manual Query Section -->
            <Border
                Grid.Row="2"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="手动查询" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="HostBox"
                            Grid.Column="0"
                            Header="主机地址"
                            PlaceholderText="127.0.0.1"
                            Text="127.0.0.1" />
                        <NumberBox
                            x:Name="PortBox"
                            Grid.Column="1"
                            Header="端口"
                            Maximum="65535"
                            Minimum="1"
                            SpinButtonPlacementMode="Compact"
                            Value="27015" />
                        <ComboBox
                            x:Name="ProtocolComboBox"
                            Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            Header="协议"
                            SelectedIndex="0">
                            <ComboBoxItem Content="A2S_INFO (Source)" Tag="A2S" />
                            <ComboBoxItem Content="Minecraft" Tag="MC" />
                            <ComboBoxItem Content="TCP Ping" Tag="TCP" />
                        </ComboBox>
                        <Button
                            x:Name="QueryButton"
                            Grid.Column="3"
                            VerticalAlignment="Bottom"
                            Click="QueryButton_Click"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Glyph="&#xE71E;" />
                                <TextBlock Text="查询" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="SaveQueryButton"
                            Grid.Column="4"
                            VerticalAlignment="Bottom"
                            Click="SaveQueryButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Glyph="&#xE74E;" />
                                <TextBlock Text="保存" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Status InfoBar -->
            <InfoBar
                x:Name="StatusInfoBar"
                Grid.Row="3"
                IsClosable="True"
                IsOpen="False" />

            <!-- Result Display Card -->
            <Border
                x:Name="ResultCard"
                Grid.Row="4"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8"
                Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="查询结果" />
                        <Border
                            x:Name="OnlineStatusBadge"
                            Grid.Column="1"
                            Padding="12,4"
                            Background="#107C10"
                            CornerRadius="4">
                            <TextBlock
                                x:Name="OnlineStatusText"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="在线" />
                        </Border>
                    </Grid>
                    <Grid ColumnSpacing="24" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Server Name -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="服务器名称" />
                            <TextBlock
                                x:Name="ResultServerName"
                                FontWeight="SemiBold"
                                Text="-"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Game Name -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="游戏" />
                            <TextBlock
                                x:Name="ResultGameName"
                                FontWeight="SemiBold"
                                Text="-" />
                        </StackPanel>

                        <!-- Map -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="地图" />
                            <TextBlock
                                x:Name="ResultMap"
                                FontWeight="SemiBold"
                                Text="-" />
                        </StackPanel>

                        <!-- Players -->
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="玩家" />
                            <TextBlock
                                x:Name="ResultPlayers"
                                FontWeight="SemiBold"
                                Text="-" />
                        </StackPanel>

                        <!-- Version -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Spacing="2">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="版本" />
                            <TextBlock
                                x:Name="ResultVersion"
                                FontWeight="SemiBold"
                                Text="-" />
                        </StackPanel>

                        <!-- Ping -->
                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="2">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="延迟" />
                            <TextBlock
                                x:Name="ResultPing"
                                FontWeight="SemiBold"
                                Text="-" />
                        </StackPanel>

                        <!-- Protocol -->
                        <StackPanel Grid.Row="3" Grid.Column="0" Spacing="2">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="协议" />
                            <TextBlock
                                x:Name="ResultProtocol"
                                FontWeight="SemiBold"
                                Text="-" />
                        </StackPanel>

                        <!-- Bots -->
                        <StackPanel x:Name="BotsPanel" Grid.Row="3" Grid.Column="1" Spacing="2"
                                    Visibility="Collapsed">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="机器人" />
                            <TextBlock
                                x:Name="ResultBots"
                                FontWeight="SemiBold"
                                Text="-" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Saved Queries Toolbar -->
            <Border
                Grid.Row="5"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="已保存的查询" />
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button x:Name="RefreshAllButton" Click="RefreshAllButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                    <TextBlock Text="全部刷新" />
                                </StackPanel>
                            </Button>
                            <ToggleSwitch
                                x:Name="AutoRefreshToggle"
                                MinWidth="0"
                                OffContent="自动刷新"
                                OnContent="自动刷新"
                                Toggled="AutoRefreshToggle_Toggled" />
                            <NumberBox
                                x:Name="RefreshIntervalBox"
                                Width="130"
                                Header="间隔(秒)"
                                Maximum="300"
                                Minimum="5"
                                SmallChange="5"
                                SpinButtonPlacementMode="Compact"
                                Value="30"
                                ValueChanged="RefreshIntervalBox_ValueChanged" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Saved Query List -->
            <Border
                Grid.Row="6"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8">
                <ListView
                    x:Name="SavedQueryListView"
                    Padding="4"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid
                                Padding="12,8"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Status indicator -->
                                <Ellipse
                                    Grid.Column="0"
                                    Width="10"
                                    Height="10"
                                    VerticalAlignment="Center"
                                    Fill="{Binding StatusColor}" />

                                <!-- Label / Host:Port -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="{Binding DisplayName}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding StatusSummary}" />
                                </StackPanel>

                                <!-- Players -->
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Text="{Binding PlayersText}" />

                                <!-- Ping -->
                                <TextBlock
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding PingText}" />

                                <!-- Protocol badge -->
                                <Border
                                    Grid.Column="4"
                                    Padding="6,2"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    CornerRadius="4">
                                    <TextBlock
                                        FontSize="11"
                                        Text="{Binding Protocol}" />
                                </Border>

                                <!-- Query button -->
                                <Button
                                    Grid.Column="5"
                                    Padding="6,4"
                                    VerticalAlignment="Center"
                                    Click="QuerySavedItem_Click"
                                    Tag="{Binding Id}"
                                    ToolTipService.ToolTip="查询">
                                    <FontIcon FontSize="12" Glyph="&#xE72C;" />
                                </Button>

                                <!-- Delete button -->
                                <Button
                                    Grid.Column="6"
                                    Padding="6,4"
                                    VerticalAlignment="Center"
                                    Click="DeleteSavedItem_Click"
                                    Tag="{Binding Id}"
                                    ToolTipService.ToolTip="删除">
                                    <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
