<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GSM3.Pages.WebhookPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock
            Grid.Row="0"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="Webhook 通知" />

        <!-- Toolbar -->
        <Border
            Grid.Row="1"
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="AddWebhookButton"
                    Click="AddWebhookButton_Click"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock Text="添加 Webhook" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="RefreshButton"
                    Click="RefreshButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock Text="刷新" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Status InfoBar -->
        <InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="2"
            IsClosable="True"
            IsOpen="False" />

        <!-- Webhook List -->
        <Border
            Grid.Row="3"
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="8">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="已配置的 Webhook" />
                <ListView
                    x:Name="WebhookListView"
                    Grid.Row="1"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid
                                Padding="8"
                                ColumnSpacing="12"
                                RowSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Icon -->
                                <FontIcon
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="24"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xED0E;" />

                                <!-- Name -->
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis" />

                                <!-- Type + URL + Instance -->
                                <StackPanel
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="12">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding WebhookType}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        MaxWidth="300"
                                        Text="{Binding Url}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        x:Name="InstanceLabel"
                                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                        Text="{Binding InstanceId}"
                                        Loaded="InstanceLabel_Loaded" />
                                </StackPanel>

                                <!-- Enabled Toggle -->
                                <ToggleSwitch
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    IsOn="{Binding Enabled, Mode=TwoWay}"
                                    Toggled="WebhookToggle_Toggled" />

                                <!-- Test Button -->
                                <Button
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Click="TestWebhookButton_Click"
                                    Tag="{Binding Id}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon FontSize="12" Glyph="&#xE768;" />
                                        <TextBlock Text="测试" />
                                    </StackPanel>
                                </Button>

                                <!-- Edit Button -->
                                <Button
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="4"
                                    VerticalAlignment="Center"
                                    Click="EditWebhookButton_Click"
                                    Tag="{Binding Id}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon FontSize="12" Glyph="&#xE70F;" />
                                        <TextBlock Text="编辑" />
                                    </StackPanel>
                                </Button>

                                <!-- Delete Button -->
                                <Button
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="5"
                                    VerticalAlignment="Center"
                                    Click="DeleteWebhookButton_Click"
                                    Tag="{Binding Id}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                        <TextBlock Text="删除" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>

    <Page.Resources>
        <!-- Add / Edit Webhook Dialog -->
        <ContentDialog
            x:Name="WebhookDialog"
            Title="添加 Webhook"
            CloseButtonText="取消"
            DefaultButton="Primary"
            PrimaryButtonText="保存"
            PrimaryButtonClick="WebhookDialog_PrimaryButtonClick">
            <StackPanel MinWidth="400" Spacing="12">
                <TextBox
                    x:Name="DialogNameBox"
                    Header="名称"
                    PlaceholderText="例如: 我的 Discord 通知" />
                <ComboBox
                    x:Name="DialogTypeCombo"
                    Header="类型"
                    HorizontalAlignment="Stretch"
                    SelectedIndex="0">
                    <ComboBoxItem Content="Discord" Tag="Discord" />
                    <ComboBoxItem Content="Telegram" Tag="Telegram" />
                    <ComboBoxItem Content="DingTalk (钉钉)" Tag="DingTalk" />
                    <ComboBoxItem Content="Custom (自定义)" Tag="Custom" />
                </ComboBox>
                <TextBox
                    x:Name="DialogUrlBox"
                    Header="Webhook URL"
                    PlaceholderText="https://..." />
                <ComboBox
                    x:Name="DialogInstanceCombo"
                    Header="目标实例"
                    HorizontalAlignment="Stretch"
                    SelectedIndex="0" />
                <TextBlock
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="事件订阅" />
                <CheckBox
                    x:Name="DialogEventCrash"
                    Content="崩溃通知" />
                <CheckBox
                    x:Name="DialogEventStart"
                    Content="启动通知" />
                <CheckBox
                    x:Name="DialogEventStop"
                    Content="停止通知" />
            </StackPanel>
        </ContentDialog>
    </Page.Resources>
</Page>
