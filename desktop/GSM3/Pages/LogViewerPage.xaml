<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GSM3.Pages.LogViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GSM3.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title row -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="日志查看器" />

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="4">
                <Button Click="RefreshButton_Click" ToolTipService.ToolTip="刷新">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock Text="刷新" />
                    </StackPanel>
                </Button>
                <ToggleButton
                    x:Name="AutoScrollToggle"
                    IsChecked="True"
                    ToolTipService.ToolTip="自动滚动到底部">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE74B;" />
                        <TextBlock Text="自动滚动" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
        </Grid>

        <!-- Instance selector + Directory selector -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox
                x:Name="InstanceSelector"
                Grid.Column="0"
                MinWidth="200"
                Header="选择实例"
                PlaceholderText="选择实例以浏览其日志..."
                SelectionChanged="InstanceSelector_SelectionChanged" />

            <TextBox
                x:Name="DirectoryPath"
                Grid.Column="1"
                KeyDown="DirectoryPath_KeyDown"
                PlaceholderText="输入日志目录路径后按回车加载..." />
            <Button
                Grid.Column="2"
                Click="BrowseButton_Click"
                ToolTipService.ToolTip="浏览文件夹">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="14" Glyph="&#xED25;" />
                    <TextBlock Text="浏览" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Search / filter + line count -->
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="SearchBox"
                Grid.Column="0"
                PlaceholderText="搜索/过滤日志内容..."
                TextChanged="SearchBox_TextChanged" />
            <TextBlock
                x:Name="LineCountText"
                Grid.Column="1"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="共 0 行" />
        </Grid>

        <!-- File list + log content viewer -->
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- File list sidebar -->
            <Border
                Grid.Column="0"
                Padding="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        FontWeight="SemiBold"
                        Text="日志文件" />
                    <ListView
                        x:Name="FileList"
                        Grid.Row="1"
                        SelectionChanged="FileList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="4,6" Spacing="2">
                                    <TextBlock FontSize="13" Text="{Binding Name}" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding ModifiedTime}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        x:Name="FileListEmpty"
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="请选择日志目录" />
                </Grid>
            </Border>

            <!-- Log content viewer -->
            <Border
                Grid.Column="1"
                Background="#0C0C0C"
                CornerRadius="8">
                <ScrollViewer
                    x:Name="LogScrollViewer"
                    Padding="12"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <TextBlock
                        x:Name="LogContent"
                        FontFamily="Cascadia Mono, Consolas, Courier New, monospace"
                        FontSize="13"
                        Foreground="#CCCCCC"
                        IsTextSelectionEnabled="True"
                        Text="选择一个日志文件以查看内容"
                        TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status bar -->
        <TextBlock
            x:Name="StatusText"
            Grid.Row="4"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}" />
    </Grid>
</Page>
